# Copy to `.env` for development or `.env.prod` for production. Both are gitignored: never commit them.
# Docker Compose reads this file via --env-file (see docker-compose.yml for the full commands).

# Required. Generate a random value, e.g.:  openssl rand -hex 24
# Use letters and digits only: the value is embedded in a connection string, so ';', '=', '$' and spaces break it.
POSTGRES_PASSWORD=

# Optional host ports. Both bind to 127.0.0.1 only. Defaults shown (dev / prod).
#POSTGRES_HOST_PORT=55432
#API_HOST_PORT=58080
