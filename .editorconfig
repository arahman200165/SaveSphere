root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx,csproj,props,targets,sln,slnx}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# EF Core migrations are tool-generated and then hand-edited for SQL; skip style/quality analyzers on them.
[**/Persistence/Migrations/*.cs]
generated_code = true
