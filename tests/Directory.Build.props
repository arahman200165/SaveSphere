<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Test-only noise: underscores in test names, public test types, ConfigureAwait, literal arrays. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861;CA1812;CA1848;CA1303;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
